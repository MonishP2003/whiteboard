NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5432/whiteboard
# At least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Integration tests truncate tables, so point them at a separate database.
# Falls back to DATABASE_URL (as in CI) when unset.
TEST_DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5432/whiteboard_test
# Google AI Studio key for the AI diagram/chart routes (they return 503 without it).
# The free tier lets Google use prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Razorpay TEST-mode keys (Dashboard → Account & Settings → API keys, with Test Mode on).
# Without them POST /payments/order returns 503 and the AI routes stay behind the paywall.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the dashboard webhook (Test Mode → Webhooks).
RAZORPAY_WEBHOOK_SECRET=
