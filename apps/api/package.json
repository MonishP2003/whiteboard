{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@google/genai": "^2.24.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.1.0",
    "@whiteboard/shared": "workspace:*",
    "fastify": "^5.2.0",
    "jose": "^6.2.12",
    "pino": "^9.6.0",
    "prisma": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
