# Serves the SPA build on the frontend instance. Plain HTTP: CloudFront
# terminates TLS and routes /api/* to the api instance, so it never gets here.
:80 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# Hashed build assets: cache forever. A missing one is a plain 404 without
	# the immutable header, never index.html (CloudFront would cache it as JS).
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is index.html or a SPA route: always revalidate.
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
